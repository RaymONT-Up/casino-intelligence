{
  "name": "casino-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1",
    "build": "next build apps/web",
    "start": "concurrently -k \"tsx --env-file=.env apps/api/src/server.ts\" \"next start apps/web --hostname 127.0.0.1\"",
    "db:migrate": "tsx --env-file=.env packages/database/migrate.ts",
    "db:seed": "tsx --env-file=.env packages/database/seed.ts",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "agents:check": "node scripts/check-agents.mjs",
    "check": "pnpm agents:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "verify": "pnpm check && pnpm test:integration && pnpm build && pnpm test:e2e",
    "collect:real": "tsx --env-file=.env scripts/collect-real.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "playwright": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
